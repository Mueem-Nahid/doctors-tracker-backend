{
  "name": "@doctor-tracker/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "admin:provision": "node --env-file-if-exists=.env --import tsx scripts/provisionAdmin.ts",
    "dashboard:seed": "node --env-file-if-exists=.env --import tsx scripts/seedDashboard.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@doctor-tracker/contracts": "*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "mongoose": "^9.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
